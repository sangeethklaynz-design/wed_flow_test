# CORS - comma-separated frontend origins
FRONTEND_ORIGIN=https://wedflow.framelabs.lk
CORS_ORIGIN=https://wedflow.framelabs.lk

# Public app URL (Connect return/refresh + Checkout success/cancel)
APP_PUBLIC_URL=https://wedflow.framelabs.lk

# Marketplace payments (Google Pay via Stripe Connect) — OFF by default
# See guide files/marketplace-payments-google-pay.md
PAYMENTS_LIVE=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Platform Google Pay & Wallet Console merchant id (one for Wedflow, not per merchant)
GOOGLE_PAY_MERCHANT_ID=
# Platform commission % of ticket total (0–100) when PAYMENTS_LIVE=true
PLATFORM_FEE_PERCENT=0
