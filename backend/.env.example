NODE_ENV=development
PORT=4000

# MySQL (set these to match your local Workbench DB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wedflow
DB_USER=root
DB_PASSWORD=Reaper@99
DB_DIALECT=mysql

# JWT (admin/couple auth)
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Optional (password hashing)
SALT_ROUNDS=10

# CORS — comma-separated origins; Vercel previews auto-allowed when production URL is listed
# Example: FRONTEND_ORIGIN=http://localhost:3000,https://wed-flow-test.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
