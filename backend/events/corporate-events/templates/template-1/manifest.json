          "type": "text",
          "label": "Question label"
        },
        "inputType": {
          "type": "select",
          "label": "Field type",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "textarea",
              "label": "Text field"
            },
            {
              "value": "dropdown",
              "label": "Dropdown menu"
            },
            {
              "value": "radio",
              "label": "Radio buttons"
            }
          ]
        },
        "options": {
          "type": "dropdownItems",
          "label": "Choices",
          "showWhen": {
            "field": "inputType",
            "in": [
              "dropdown",
              "radio"
            ]
